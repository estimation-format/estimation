{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estrec.org/schema/estrec-table-0.1.json",
  "title": "estrec-table/0.1",
  "x-license": "CC0-1.0",
  "description": "A table spec: how to lay out a regression table from estimation records (columns, rows and labels, statistics rows, number format). It holds no results; every number comes from the records when the table is rendered. Specification: spec/table.md. A companion to the estimation format, versioned on its own.",
  "type": "object",
  "required": ["schema", "meta", "columns"],
  "properties": {
    "schema": {"const": "estrec-table/0.1"},
    "meta": {
      "type": "object",
      "required": ["id", "created"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "created": {"type": "string", "format": "date-time"},
        "producer": {
          "type": "object",
          "required": ["name"],
          "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
        },
        "tags": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "title": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "description": "A record file, a folder of records or a collection, relative to the spec's folder."}
        },
        "additionalProperties": false
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["record"],
        "properties": {
          "record": {"type": "string", "minLength": 1, "description": "The record's meta.id."},
          "source": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "header": {"type": "string"},
          "vcov": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0}]},
          "component": {"type": "string"},
          "response": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {"type": "string"},
          "terms": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "label": {"type": "string"}
        },
        "oneOf": [{"required": ["term"]}, {"required": ["terms"]}],
        "additionalProperties": false
      }
    },
    "keep": {"type": "array", "items": {"type": "string"}},
    "drop": {"type": "array", "items": {"type": "string"}},
    "keep_unlisted": {"type": "boolean"},
    "uncertainty": {
      "description": "The lines under each estimate: one name, a template, a list of names, templates and sparklines (one row each), or null for none. Templates use {estimate}, {std_error}, {statistic}, {p_value}, {conf_low}, {conf_high}.",
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/line"},
        {"type": "array", "items": {"$ref": "#/$defs/line"}, "minItems": 1}
      ]
    },
    "estimate": {"type": "boolean", "description": "false leaves out each term's estimate row, so the lines alone show it (the first carries the term's label). Default true."},
    "stars": {
      "anyOf": [
        {"type": "null"},
        {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "minItems": 1}
      ]
    },
    "stats": {"type": "array", "items": {"$ref": "#/$defs/stat"}},
    "head": {
      "description": "The heading rows, top to bottom: column numbers (1), (2), ...; the dependent variable; the column labels (`header`, else the member label, else the record's title). Default [\"number\", \"response\"]; [] for none.",
      "type": "array",
      "items": {"enum": ["number", "response", "label"]},
      "uniqueItems": true
    },
    "response_labels": {
      "description": "Display names for dependent variables in the response row, by name.",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "format": {
      "type": "object",
      "properties": {
        "digits": {"type": "integer", "minimum": 0, "maximum": 12},
        "thousands": {"type": "string"},
        "missing": {"type": "string"},
        "fe_yes": {"type": "string"},
        "fe_no": {"type": "string"},
        "star_symbols": {"type": "array", "items": {"type": "string"}},
        "p_digits": {"type": "integer", "minimum": 0, "maximum": 12, "description": "Decimals for p-values; default `digits`."},
        "p_style": {"enum": ["fixed", "less_than"], "description": "fixed: 0.000; less_than: <0.001 below the smallest value p_digits can show. Default fixed."}
      },
      "additionalProperties": false
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "line": {
      "anyOf": [
        {"enum": ["std_error", "statistic", "p_value", "conf_int"]},
        {"type": "string", "pattern": "\\{(estimate|std_error|statistic|p_value|conf_low|conf_high)\\}"},
        {
          "type": "object",
          "description": "The confidence interval drawn as a small line: a dot at each end in `color`, the estimate as a darker dot, 0 as a grey rule. `scale`: one axis down each column (default), along each row, or across the table. Formats that can't draw show [conf_low, conf_high].",
          "required": ["sparkline"],
          "properties": {
            "sparkline": {
              "type": "object",
              "properties": {
                "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
                "scale": {"enum": ["column", "row", "table"]}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "stat": {
      "type": "object",
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "vcov": {"enum": ["type", "n_clusters"]},
        "fixed_effect": {"type": "string", "minLength": 1},
        "test": {"type": "string", "minLength": 1},
        "value": {"enum": ["statistic", "p_value"]},
        "values": {"type": "array", "items": {"type": "string"}},
        "label": {"type": "string"},
        "digits": {"type": "integer", "minimum": 0, "maximum": 12}
      },
      "oneOf": [
        {"required": ["metric"]},
        {"required": ["vcov"]},
        {"required": ["fixed_effect"]},
        {"required": ["test"]},
        {"required": ["values", "label"]}
      ],
      "additionalProperties": false
    }
  }
}
