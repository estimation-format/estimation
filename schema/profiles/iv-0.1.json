{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estimation-format.github.io/estimation/schema/profiles/iv-0.1.json",
  "title": "iv/0.1",
  "x-license": "CC0-1.0",
  "description": "Profile for instrumental-variables models: Stata ivregress, ivreg2, ivreghdfe; R fixest, ivreg, estimatr iv_robust, lfe; Python linearmodels, pyfixest; FixedEffectModels.jl (survey 2026-10-24 in docs/design/estimation-format.md). Requires inference/0.1 plus specification.endogenous and specification.instruments (excluded instruments), which every tool stores. A first-stage F test in `tests` is expected, not required: most tools compute first-stage statistics only on request. A FE IV record also claims linear-fe/0.1.",
  "x-extends": ["inference/0.1"],
  "x-deviations": [],
  "allOf": [
    {"$ref": "../estimation-0.1.json"},
    {"$ref": "#/$defs/rules"}
  ],
  "$defs": {
    "rules": {
      "allOf": [{"$ref": "inference-0.1.json#/$defs/rules"}],
      "type": "object",
      "required": ["specification"],
      "properties": {
        "specification": {
          "required": ["endogenous", "instruments"],
          "properties": {
            "endogenous": {"description": "Endogenous regressors.", "minItems": 1},
            "instruments": {"description": "Excluded instruments.", "minItems": 1}
          }
        },
        "metrics": {
          "properties": {
            "kappa": {"description": "k-class parameter (LIML lambda).", "x-tools": {"ivregress": "e(kappa)", "ivreg2": "e(lambda)", "linearmodels": "kappa"}},
            "fuller": {"description": "Fuller parameter.", "x-tools": {"ivreg2": "e(fuller)"}}
          }
        },
        "structures": {"properties": {"first_stage": {"$ref": "#/$defs/first_stage"}}},
        "tests": {
          "description": "IV tests by category (core $defs/test). Writers SHOULD include the first-stage F when the tool computed it; validators warn when no first_stage test is present.",
          "x-expected-tests": ["first_stage"],
          "x-categories": {
            "first_stage": {
              "description": "F (or robust Wald F) of the excluded instruments in one first stage: component \"first_stage\", response = the endogenous variable, vcov = the vcov used.",
              "names": ["f", "wald", "sanderson_windmeijer_f", "angrist_pischke_f", "effective_f"],
              "x-tools": {
                "f / wald": {
                  "ivregress": "estat firststage r(singleresults) F",
                  "ivreg2/ivreghdfe": "e(first) F",
                  "fixest": "fitstat ivf1 (ivwald1 robust)",
                  "ivreg": "summary diagnostics \"Weak instruments\"",
                  "estimatr": "diagnostic_first_stage_fstatistic",
                  "lfe": "stage1$iv1fstat / rob.iv1fstat",
                  "linearmodels": "first_stage.diagnostics f.stat",
                  "pyfixest": "_f_stat_1st_stage"
                },
                "sanderson_windmeijer_f": {
                  "ivreg2/ivreghdfe": "e(first) SWF, SWFdf1, SWFdf2, SWFp",
                  "lfe": "condfstat()"
                },
                "angrist_pischke_f": {"ivreg2/ivreghdfe": "e(first) APF, APFdf1, APFdf2, APFp"},
                "effective_f": {"pyfixest": "_eff_F (IV_Diag)"}
              }
            },
            "underidentification": {
              "description": "Rank test of the first stage: Anderson LM (iid) or Kleibergen-Paap rk LM.",
              "names": ["anderson_lm", "kleibergen_paap_rk_lm"],
              "x-tools": {"ivreg2/ivreghdfe": "e(idstat), e(idp), e(iddf)"}
            },
            "weak_identification": {
              "description": "Weak-identification statistics and weak-instrument-robust tests of the endogenous coefficients. Cragg-Donald and Kleibergen-Paap F have no p-value: compare with Stock-Yogo critical values.",
              "names": ["cragg_donald_f", "kleibergen_paap_rk_wald_f", "anderson_rubin", "stock_wright"],
              "x-tools": {
                "cragg_donald_f": {
                  "ivregress": "estat firststage r(mineig)",
                  "ivreg2/ivreghdfe": "e(cdf)",
                  "fixest": "fitstat cd",
                  "linearmodels": "first_stage.cragg_donald_f"
                },
                "kleibergen_paap_rk_wald_f": {
                  "ivreg2/ivreghdfe": "e(rkf)",
                  "fixest": "fitstat kpr: e(rkf) x (N-K)/N; only with a non-iid vcov and exact identification; drop its chi2 p-value",
                  "linearmodels": "first_stage.kleibergen_paap_f",
                  "FixedEffectModels.jl": "F_kp, p_kp"
                },
                "anderson_rubin": {"ivreg2/ivreghdfe": "e(arf), e(arfp) / e(archi2), e(archi2p)"},
                "stock_wright": {"ivreg2/ivreghdfe": "e(sstat), e(sstatp), e(sstatdf)"}
              }
            },
            "overidentification": {
              "description": "Tests of the overidentifying restrictions; tools report several versions, so a record may hold more than one.",
              "names": ["sargan", "basmann", "score", "hansen_j", "anderson_rubin"],
              "x-tools": {
                "ivregress": "estat overid (sargan, basmann, score; LIML ar; GMM HansenJ)",
                "ivreg2/ivreghdfe": "e(j), e(sargan)",
                "fixest": "iv_sargan",
                "ivreg": "summary diagnostics \"Sargan\"",
                "estimatr": "diagnostic_overid_test",
                "linearmodels": "sargan, basmann, basmann_f, wooldridge_overid"
              }
            },
            "endogeneity": {
              "description": "Tests that the endogenous regressors are exogenous.",
              "names": ["durbin", "wu_hausman", "score", "c"],
              "x-tools": {
                "ivregress": "estat endogenous (durbin, wu, r_score)",
                "ivreg2/ivreghdfe": "e(estat) with endog()",
                "fixest": "iv_wh",
                "ivreg": "summary diagnostics \"Wu-Hausman\"",
                "estimatr": "diagnostic_endogeneity_test",
                "linearmodels": "wu_hausman(), durbin(), wooldridge_score, wooldridge_regression"
              }
            }
          }
        }
      }
    },
    "first_stage": {
      "description": "First-stage summaries that aren't tests (R\u00b2s per endogenous regressor). The first-stage F and the identification, overidentification and endogeneity tests are in `tests`. Per-coefficient first-stage estimates go in parameters with component \"first_stage\" and response = the endogenous variable.",
      "allOf": [{"$ref": "../estimation-0.1.json#/$defs/structure"}],
      "properties": {
        "kind": {"enum": ["object", "link"]},
        "per_endogenous": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["endogenous"],
            "properties": {
              "endogenous": {"type": "string"},
              "r2": {"$ref": "../estimation-0.1.json#/$defs/number_or_null", "x-tools": {"ivregress": "r(singleresults)", "linearmodels": "rsquared"}},
              "partial_r2": {"$ref": "../estimation-0.1.json#/$defs/number_or_null", "x-tools": {"ivregress": "r(singleresults)", "ivreg2/ivreghdfe": "e(first) pr2", "linearmodels": "partial.rsquared"}},
              "shea_partial_r2": {"$ref": "../estimation-0.1.json#/$defs/number_or_null", "x-tools": {"ivregress": "r(multiresults)", "ivreg2/ivreghdfe": "e(first) sheapr2", "linearmodels": "shea.rsquared"}}
            }
          }
        }
      }
    }
  }
}
